# Fyers app configuration
redirect_uri=https://your-redirect-uri.example/callback
client_id=your_app_id-100
secret_key=your_app_secret
grant_type=authorization_code
response_type=code
state=sample

# Add this after completing the login URL flow.
# auth_code=your_auth_code

# Required only for refresh-token flow.
# pin=your_fyers_pin

# Optional browser wait timeout in seconds.
# auth_timeout_seconds=300

# Set true to use the terminal paste flow instead of launching Chromium.
# browser_headless=false

# Lot size is resolved from the exact Fyers contract; quantity uses fresh funds.
# Ceiling preserves the requested rule but SKIPS unaffordable rounded quantities.
# Use floor to choose affordable whole lots instead.
FYERS_SIZING_ROUNDING=ceil
FYERS_MAX_QUANTITY=10000
# Optional fixed cash reserve for fees/slippage; zero uses the entire available balance.
FYERS_FUNDS_RESERVE=0

# After T3, keep the runner and trail only on new highs.
# Gap = max(high * percent / 100, one-minute ATR * multiple).
FYERS_TRAILING_PERCENT=3
FYERS_TRAILING_ATR_MULTIPLE=2
FYERS_ORDER_POLL_SECONDS=1
# Set the correct tick size for the selected contract.
FYERS_PRICE_TICK=0.05
